# Copy to .env — every variable is optional.

# Port on your machine (the container always listens on 4317 inside)
PORT=4317

# Protect the admin UI and /api/* (strongly recommended outside localhost)
# BRAIN_ADMIN_TOKEN=change-me

# LLM — or leave empty and choose a provider in the UI (Settings → Language model).
# With Docker, an LLM server running on your machine (Ollama, LM Studio, vLLM) is
# reachable at http://host.docker.internal:<port>/v1 — not localhost.
# Setting just one vendor key auto-selects that provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# Explicit provider (anthropic | openai | gemini | deepseek | mistral | groq | xai | openrouter | together | ollama | vllm | lmstudio | custom | offline)
# BRAIN_LLM_PROVIDER=
# BRAIN_LLM_MODEL=
# BRAIN_LLM_BASE_URL=
# BRAIN_LLM_API_KEY=

# Force offline mode (rules + templates, no LLM calls)
# BRAIN_OFFLINE=1

# Time zone for the nightly sleep (the Docker image runs in UTC otherwise)
# TZ=Asia/Ho_Chi_Minh

# Automatic sleep cycle — defaults; settings saved in the UI (Settings → Sleep cycle) win
# BRAIN_SLEEP_AUTO=1               # 0 = only sleep when the button is pressed
# BRAIN_SLEEP_IDLE_MINUTES=30      # nap after a customer has been quiet this long
# BRAIN_SLEEP_MAX_PENDING=24       # or as soon as this many turns are waiting (max 38)
# BRAIN_SLEEP_NIGHTLY_AT=03:00     # daily run, server time; "off" to disable
# BRAIN_SLEEP_CHECK_SECONDS=60     # how often the scheduler looks
