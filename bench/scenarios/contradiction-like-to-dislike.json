{
  "id": "contradiction-like-to-dislike",
  "category": "contradiction",
  "lang": "en",
  "description": "A changed preference replaces the old one.",
  "steps": [
    {
      "agent": "mia",
      "say": "I love spicy food"
    },
    {
      "advance": "5d"
    },
    {
      "agent": "mia",
      "say": "I don't like spicy food anymore"
    },
    {
      "advance": "1h"
    },
    {
      "agent": "nova",
      "recall": "Suggest some snacks for me",
      "expect": {
        "remembers": [
          "/(dislikes?|does not like|doesn't like|no longer (likes?|enjoys?)|not a fan of)[^.\\n]{0,30}spicy/i"
        ],
        "stale": [
          "/(^|\\buser\\s)likes:? spicy/i"
        ]
      }
    }
  ]
}
